font_fill : g i ?
	i > 34 : 0
	((FONT_BUF + (i * 4)) # ((g >> (34 - i)) && 1)) : font_fill g (i + 1)
	0

font_blit : x y sc col ? seq9 (4x09100008 # col) (4x0910000C # x) (4x09100010 # y) (4x09100018 # 5) (4x0910001C # 7) (4x09100028 # FONT_BUF) (4x09100030 # sc) (4x09100034 # 4) (4x09100014 # 6)
font_char : c x y sc col ?
	seq5 (font_fill (font_glyph c) 0) (font_blit x y sc col) (4x09100030 # 1) (4x09100034 # 0) (x + (6 * sc))

font_text : s x y sc col ? font_text2 s x x y sc col
font_text2 : s x0 x y sc col ?
	(@s) = 0 : x
	(@s) = 10 : font_text2 (s + 4) x0 x0 (y + (8 * sc)) sc col
	font_text2 (s + 4) x0 (font_char (@s) x y sc col) y sc col

font_print : lit x y sc col ? seq2 (str_put FONT_STR lit) (font_text FONT_STR x y sc col)
font_int : n x y sc col ? seq2 (str_int FONT_STR n) (font_text FONT_STR x y sc col)
font_width : s sc ? ((str_len s) * 6 * sc) - sc
