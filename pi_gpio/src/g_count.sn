`std.sn`@~
G : 0x9500000
T : 0x9200000
w : ms ? (T + 4) # ms
dir : n d ? (G + 0x100 + (4 * n)) # d
put : n v ? seq2 ((G + (4 * n)) # v) (w 5)
get : n ? @(G + (4 * n))
r : a b ? a * 10 + b
`17 を 200 回変えて、そのたびに 27 が同じ値かを数える。期待 200
chk : i ? seq2 (put 17 (i % 2)) (get 27)
eq : a b ?
	a = b : 1
	0
loop : i n ?
	i = 200 : n
	loop (i + 1) (n + (eq (chk i) (i % 2)))
seq3 (dir 27 0) (dir 17 1) (loop 0 0)
